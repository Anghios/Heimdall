<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Heimdall">
  <diagram name="Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t-start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#16A34A;fontColor=#ffffff;strokeColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t-step" value="Step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;fontColor=#ffffff;strokeColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="200" y="150" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t-choice" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D97706;fontColor=#ffffff;strokeColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="190" y="260" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t-end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B91C1C;fontColor=#ffffff;strokeColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="200" y="390" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t-alt" value="Alternative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;fontColor=#ffffff;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="400" y="270" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6272A4;" edge="1" parent="1" source="t-start" target="t-step">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6272A4;" edge="1" parent="1" source="t-step" target="t-choice">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6272A4;" edge="1" parent="1" source="t-choice" target="t-end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t-e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6272A4;" edge="1" parent="1" source="t-choice" target="t-alt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
