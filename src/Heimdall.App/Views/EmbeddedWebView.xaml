<!-- A web console (iLO, iDRAC, switch, NAS) in a session tab. Labels are set from the
     localizer in InitializeSessionAsync, as the VNC view does. -->
<UserControl x:Class="Heimdall.App.Views.EmbeddedWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border Grid.Row="0"
                Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="SplitButton"
                        DockPanel.Dock="Right"
                        Content="&#xE8A9;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnSplitClick"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"/>

                <Button x:Name="ReloadButton"
                        DockPanel.Dock="Left"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnReloadClick"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="0,0,4,0"/>

                <Button x:Name="BackButton"
                        DockPanel.Dock="Left"
                        Content="&#xE72B;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnBackClick"
                        IsEnabled="False"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="0,0,4,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitleText"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="AddressTextBlock"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" - " Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Panel.ZIndex="1"
                     Height="2"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsHitTestVisible="False"/>

        <Grid Grid.Row="1" ClipToBounds="True">
            <wv2:WebView2 x:Name="ConsoleWebView"
                          Focusable="True"/>

            <Border x:Name="FallbackPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource BackgroundBrush}"
                    Padding="28">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock x:Name="FallbackTitleText"
                               FontSize="{StaticResource FontSizeDisplay}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="FallbackMessageText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="FallbackRetryButton"
                            Click="OnReloadClick"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="16,6"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
